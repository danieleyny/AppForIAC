// Paste these rules in Firebase console -> Firestore Database -> Rules -> Publish.
//
// This config is open read/write to the `cars` and `submissions` collections,
// suitable for a small internal team. It blocks everything else.
// If the app is ever exposed publicly, add Firebase Authentication and tighten
// these rules (e.g. `allow read, write: if request.auth != null;`).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cars/{carId} {
      allow read, write: if true;
    }
    match /submissions/{submissionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
